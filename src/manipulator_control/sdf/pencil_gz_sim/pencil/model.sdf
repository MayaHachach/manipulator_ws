<?xml version="1.0" ?>
<!--
  Pencil Model — Gazebo Sim (Harmonic / Ionic / Jetty)
  ======================================================
  Renderer  : Ogre2
  SDF ver   : 1.9
  Scale     : Real-world (SI units, metres)

  Anatomy along Z-axis (pencil standing tip-down):
    z = 0.000 → 0.015  Graphite tip  (narrow dark-grey cylinder)
    z = 0.015 → 0.021  Wood sheath   (tapered wood-coloured cylinder)
    z = 0.021 → 0.165  Hex body      (6 yellow box panels + inner cylinder fill)
    z = 0.165 → 0.175  Ferrule       (silver metallic band)
    z = 0.175 → 0.190  Eraser        (pink cylinder)

  Hexagon geometry:
    flat-to-flat diameter  d = 0.007 m
    circumradius           R = d / sqrt(3) ≈ 0.004041 m
    panel centre offset    = d/2 = 0.0035 m (along their normal)
    panel face width       = R   = 0.004041 m
    panel thickness        = 0.0012 m

  NOTE on Ogre2 colours:
    Ogre2 uses a PBR pipeline; ambient values have less effect than in Ogre1.
    Boost diffuse to ~1.0 and keep ambient ≥ 0.6 for correct brightness.
    No <script> tags — those are Gazebo-classic / Ogre1 only.
-->
<sdf version="1.9">
  <model name="pencil">

    <!-- Static prop — change to false for physics simulation -->
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>3e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>3e-6</iyy><iyz>0</iyz>
          <izz>1e-7</izz>
        </inertia>
      </inertial>

      <!-- ══════════════════════════════════════════
           GRAPHITE TIP  z = 0 → 0.015
           Thin dark-grey cylinder (graphite)
      ══════════════════════════════════════════ -->
      <visual name="tip_graphite">
        <pose>0 0 0.0055 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0006</radius>
            <length>0.011</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.18 0.18 0.18 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- ══════════════════════════════════════════
           WOOD SHEATH  z = 0.011 → 0.021
           Slightly wider section — exposed bare wood
      ══════════════════════════════════════════ -->
      <visual name="tip_wood">
        <pose>0 0 0.016 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0022</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.50 0.28 1</ambient>
          <diffuse>0.85 0.62 0.35 1</diffuse>
          <specular>0.08 0.06 0.04 1</specular>
        </material>
      </visual>

      <!-- Tip collision covers both graphite + wood sheath -->
      <collision name="tip_col">
        <pose>0 0 0.0105 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0022</radius>
            <length>0.021</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- ══════════════════════════════════════════
           HEX BODY  z = 0.021 → 0.165   length = 0.144 m
           Centre z = 0.021 + 0.072 = 0.093

           6 box panels at 0°, 60°, 120°, 180°, 240°, 300°
           Each panel: size = (thickness × face_width × body_length)
                             = (0.0012 × 0.004041 × 0.144)
           Offset outward by 0.0035 m, then rotated about Z.

           Panel positions (x, y) in model frame:
             0°   →  ( 0.0035,  0.0000)
             60°  →  ( 0.0017,  0.0030)
             120° →  (-0.0017,  0.0030)
             180° →  (-0.0035,  0.0000)
             240° →  (-0.0017, -0.0030)
             300° →  ( 0.0017, -0.0030)

           Each panel is rotated so its 0.0012 m thickness is the radial direction.
      ══════════════════════════════════════════ -->

      <!-- Inner fill cylinder — ensures no visible gap between panels -->
      <visual name="body_fill">
        <pose>0 0 0.093 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00340</radius>
            <length>0.144</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.82 0.08 1</ambient>
          <diffuse>1.00 0.88 0.10 1</diffuse>
          <specular>0.30 0.25 0.03 1</specular>
        </material>
      </visual>

      <!-- Panel 0 — 0° (faces +X) -->
      <visual name="body_p0">
        <pose>0.0035 0 0.093  0 0 0</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
        <material>
          <ambient>0.95 0.82 0.08 1</ambient>
          <diffuse>1.00 0.88 0.10 1</diffuse>
          <specular>0.35 0.30 0.04 1</specular>
        </material>
      </visual>
      <collision name="body_p0_col">
        <pose>0.0035 0 0.093  0 0 0</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
      </collision>

      <!-- Panel 1 — 60° -->
      <visual name="body_p1">
        <pose>0.001750 0.003031 0.093  0 0 1.047198</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
        <material>
          <ambient>0.90 0.77 0.07 1</ambient>
          <diffuse>0.96 0.83 0.09 1</diffuse>
          <specular>0.35 0.30 0.04 1</specular>
        </material>
      </visual>
      <collision name="body_p1_col">
        <pose>0.001750 0.003031 0.093  0 0 1.047198</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
      </collision>

      <!-- Panel 2 — 120° -->
      <visual name="body_p2">
        <pose>-0.001750 0.003031 0.093  0 0 2.094395</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
        <material>
          <ambient>0.95 0.82 0.08 1</ambient>
          <diffuse>1.00 0.88 0.10 1</diffuse>
          <specular>0.35 0.30 0.04 1</specular>
        </material>
      </visual>
      <collision name="body_p2_col">
        <pose>-0.001750 0.003031 0.093  0 0 2.094395</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
      </collision>

      <!-- Panel 3 — 180° (faces -X) -->
      <visual name="body_p3">
        <pose>-0.0035 0 0.093  0 0 3.141593</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
        <material>
          <ambient>0.90 0.77 0.07 1</ambient>
          <diffuse>0.96 0.83 0.09 1</diffuse>
          <specular>0.35 0.30 0.04 1</specular>
        </material>
      </visual>
      <collision name="body_p3_col">
        <pose>-0.0035 0 0.093  0 0 3.141593</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
      </collision>

      <!-- Panel 4 — 240° -->
      <visual name="body_p4">
        <pose>-0.001750 -0.003031 0.093  0 0 4.188790</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
        <material>
          <ambient>0.95 0.82 0.08 1</ambient>
          <diffuse>1.00 0.88 0.10 1</diffuse>
          <specular>0.35 0.30 0.04 1</specular>
        </material>
      </visual>
      <collision name="body_p4_col">
        <pose>-0.001750 -0.003031 0.093  0 0 4.188790</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
      </collision>

      <!-- Panel 5 — 300° -->
      <visual name="body_p5">
        <pose>0.001750 -0.003031 0.093  0 0 5.235988</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
        <material>
          <ambient>0.90 0.77 0.07 1</ambient>
          <diffuse>0.96 0.83 0.09 1</diffuse>
          <specular>0.35 0.30 0.04 1</specular>
        </material>
      </visual>
      <collision name="body_p5_col">
        <pose>0.001750 -0.003031 0.093  0 0 5.235988</pose>
        <geometry><box><size>0.0012 0.004041 0.144</size></box></geometry>
      </collision>

      <!-- ══════════════════════════════════════════
           FERRULE  z = 0.165 → 0.175   (silver band)
           Centre z = 0.170
      ══════════════════════════════════════════ -->
      <visual name="ferrule">
        <pose>0 0 0.170 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00405</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>
        <material>
          <!-- Bright metallic silver for Ogre2 -->
          <ambient>0.80 0.80 0.82 1</ambient>
          <diffuse>0.90 0.90 0.92 1</diffuse>
          <specular>1.00 1.00 1.00 1</specular>
          <emissive>0.03 0.03 0.03 1</emissive>
        </material>
      </visual>
      <collision name="ferrule_col">
        <pose>0 0 0.170 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00405</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- ══════════════════════════════════════════
           ERASER  z = 0.175 → 0.190   (pink rubber)
           Centre z = 0.1825
      ══════════════════════════════════════════ -->
      <visual name="eraser">
        <pose>0 0 0.1825 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00375</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <!-- Bright pink — boosted for Ogre2 PBR pipeline -->
          <ambient>0.92 0.52 0.60 1</ambient>
          <diffuse>1.00 0.62 0.70 1</diffuse>
          <specular>0.15 0.08 0.10 1</specular>
        </material>
      </visual>
      <collision name="eraser_col">
        <pose>0 0 0.1825 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00375</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
