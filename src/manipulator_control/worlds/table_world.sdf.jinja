<?xml version="1.0"?>
<sdf version="1.9">
  <world name="manipulator_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.9 0.9 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <light name="top_light" type="point">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.25 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.02</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.02</size></box></geometry>
          <material>
           
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
            <!--<ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular> -->
            
          </material>
        </visual>
        <collision name="leg1"><pose>0.35 0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="leg1_v"><pose>0.35 0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
        <collision name="leg2"><pose>-0.35 0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="leg2_v"><pose>-0.35 0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
        <collision name="leg3"><pose>0.35 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="leg3_v"><pose>0.35 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
        <collision name="leg4"><pose>-0.35 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry></collision>
        <visual name="leg4_v"><pose>-0.35 -0.35 0.375 0 0 0</pose><geometry><box><size>0.05 0.05 0.75</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         Camera — pose injected from launch file via Jinja2 parameters
         Defaults match your current working pose if nothing is passed.
    ═══════════════════════════════════════════════════════════════════ -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>
        {{ cam_x   | default(1.0)    }}
        {{ cam_y   | default(0.0)    }}
        {{ cam_z   | default(1.15)   }}
        {{ cam_roll  | default(0.0)  }}
        {{ cam_pitch | default(0.6)  }}
        {{ cam_yaw   | default(3.1415) }}
      </pose>

      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>

        <sensor name="overhead_camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/gz/camera</topic>
          <camera>
            <horizontal_fov>1.0855</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>RGB_INT8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>